# PocketBase runtime database and preserved run snapshots
.fe-run/
.fe-run.*/
# `run-chain-single.sh --fresh` scratch instances (`.fe-run-chain-<ts>`). Neither
# pattern above matches these: `.fe-run/` needs the slash, `.fe-run.*/` needs the
# dot — so without this line a full browser run leaves a committable data dir.
.fe-run-*/
.evidence-*/
*.db
*.db-shm
*.db-wal
*.db-journal

# Local build outputs
.fe.exe
.evidence.exe
*.exe

# Temporary route backups kept locally for recovery
internal/_router.bak-*/

# Backup/restore drill scratch dirs and release-check temporaries
.drill*/
.tmp-drill/
.tmp-release-check/

# Browser runtime dependency and session state (cookies, caches, local state)
tests/browser/node_modules/
tests/browser/profile/
tests/browser/profile.*/

# Generated logs by default; keep the final end-to-end run logs as evidence
tests/logs/*.log
!tests/logs/run1-bootstrap.mjs.log
!tests/logs/run2-project.mjs.log
!tests/logs/run3-issue.mjs.log
!tests/logs/run4-project-pages.mjs.log
!tests/logs/run5-publish-space.mjs.log
!tests/logs/verify-profile.mjs.log
tests/logs/.*
tests/logs/sidebar.transformed.js

# Preserved backup directories/files stay local; canonical evidence remains tracked
tests/evidence/old.bak-*/
tests/evidence/stale-2024/
tests/evidence/network.log.bak-*
tests/evidence/screenshots.bak-*/
tests/evidence/screenshots.aborted-*/
tests/evidence/screenshots.stale-bak-*/

tests/smoke/.*.txt

# Upgrade drill scratch (per-run timestamped dir, safe to delete by hand)
.upgrade-*/
# Python bytecode from tests/pbdata.py
tests/__pycache__/
# Leftover probe from the gen-vectors experiment
*.tmp.cjs
# Test scratch kept out of the index
.scratch/

tests/logs/*.bak

# Playwright CLI 会话状态（探针残留）
.playwright-cli/
playwright-cli.json
